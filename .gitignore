# Regole globali valide per tutto il monorepo.
# Le regole specifiche di ogni sotto-progetto (node_modules, dist, .next, .expo, ecc.)
# vivono nel .gitignore di quel sotto-progetto, non qui.

# File di sistema
.DS_Store
Thumbs.db

# Editor / IDE
.vscode/settings.json
.idea/

# Variabili d'ambiente
.env
.env.local
.env.production
.env*.local

# Log generici
npm-debug.log*
yarn-error.log*
**/.vscode/
**/node_modules/
