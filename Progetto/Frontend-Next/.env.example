# Base URL del backend NestJS RE|CARS (senza slash finale) — src/lib/api.ts.
# In sviluppo locale il backend gira su http://localhost:3000 (pnpm start:dev in Progetto/Backend).
# In produzione: URL del backend Render, es. https://recars-backend.onrender.com
# (visibile in alto nella dashboard del servizio web su Render dopo il primo deploy).
NEXT_PUBLIC_API_URL=http://localhost:3000
