# Porta su cui il server NestJS resta in ascolto — src/main.ts
# Su Render lasciala vuota/non impostarla: Render inietta PORT automaticamente
# nell'ambiente del servizio, il codice legge process.env.PORT con fallback a 3000.
PORT=3000

# Connection string PostgreSQL usata da Prisma tramite @prisma/adapter-pg — src/prisma.service.ts
# In produzione: URL PostgreSQL copiata dalla dashboard Neon (Connection Details
# del progetto/branch, formato postgresql://user:password@host/db?sslmode=require).
DATABASE_URL=postgresql://user:password@localhost:5432/recars

# Segreto usato per firmare e verificare i token JWT — src/jwt.strategy.ts, app.module.ts, officina/officina.module.ts
# Stringa casuale lunga almeno 32 caratteri (es. generata con `openssl rand -base64 32`).
JWT_SECRET=una-stringa-segreta-molto-lunga-e-casuale

# Account Gmail usato come mittente SMTP da Nodemailer per le email di conferma prenotazione — src/mailer.module.ts
MAIL_USER=nome.esempio@gmail.com

# App Password Gmail (non la password normale dell'account) associata a MAIL_USER — src/mailer.module.ts
# Si genera da account Google -> Sicurezza -> Verifica in due passaggi -> Password per le app.
MAIL_PASS=xxxxxxxxxxxxxxxx

# Dominio Vercel di produzione del frontend, usato da src/main.ts per popolare la
# whitelist CORS. Esempio: https://recars.vercel.app (URL assegnato da Vercel dopo
# il primo deploy del progetto Frontend-Next, oppure il dominio custom se collegato).
FRONTEND_URL=https://recars.vercel.app

# Base URL del frontend, usata per costruire i success_url/cancel_url di Stripe Checkout
# — src/stripe/stripe.controller.ts. In produzione va allineata a FRONTEND_URL
# (stesso dominio Vercel), qui separata perché storicamente ha uno scopo diverso.
FRONTEND_BASE_URL=http://127.0.0.1:5500/Frontend

# Chiave segreta dell'account Stripe, usata dall'SDK server-side per creare sessioni di checkout
# — src/stripe/stripe.service.ts. Dashboard Stripe -> Sviluppatori -> Chiavi API -> Chiave segreta
# (usare la chiave "live" per produzione, "test" per sviluppo).
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxx

# Chiave pubblica Stripe (presente storicamente nel .env del progetto, non risulta consumata nel codice backend attuale)
STRIPE_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxx

# Price ID Stripe del piano utente "Premium" — src/stripe/stripe.service.ts
# Dashboard Stripe -> Sezione Prodotti -> apri il prodotto/prezzo -> copia l'ID che inizia con "price_".
STRIPE_PRICE_PREMIUM=price_xxxxxxxxxxxxxxxxxx

# Price ID Stripe del piano utente "Pro" — src/stripe/stripe.service.ts
# Dashboard Stripe -> Sezione Prodotti -> ID prezzo ("price_...").
STRIPE_PRICE_PRO=price_xxxxxxxxxxxxxxxxxx

# Price ID Stripe del piano officina "Business" — src/stripe/stripe.service.ts
# Dashboard Stripe -> Sezione Prodotti -> ID prezzo ("price_...").
STRIPE_PRICE_BUSINESS=price_xxxxxxxxxxxxxxxxxx

# Price ID Stripe del piano officina "Business Pro" — src/stripe/stripe.service.ts
# Dashboard Stripe -> Sezione Prodotti -> ID prezzo ("price_...").
STRIPE_PRICE_BUSINESS_PRO=price_xxxxxxxxxxxxxxxxxx

# Secret usato per verificare la firma degli eventi ricevuti sul webhook Stripe (POST /abbonamento/webhook)
# — src/stripe/stripe.service.ts. Si ottiene da Dashboard Stripe -> Sviluppatori -> Webhook,
# DOPO aver creato l'endpoint puntato all'URL pubblico di Render
# (https://<nome-servizio>.onrender.com/abbonamento/webhook): il secret "whsec_..."
# viene mostrato solo dopo la creazione dell'endpoint, non prima.
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxx
